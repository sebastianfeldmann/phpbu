<?xml version="1.0" encoding="UTF-8"?>
<sync type="sftp">
  <!-- mandatory -->
  <option name="host" value="backup.example.com" />

  <!-- mandatory -->
  <option name="user" value="user.name" />

  <!-- optional, if key presented it is used as key password -->
  <option name="password" value="mysecret" />

  <!-- optional, default 22 -->
  <option name="port" value="22" />

  <!-- optional -->
  <option name="key" value="somedir/id_rsa" />

  <!-- optional, recommended: SHA256 fingerprint of the server's RSA host key;
       without it the server is not authenticated before the login
       ssh-keyscan -t rsa backup.example.com | ssh-keygen -lf - -->
  <option name="hostKeyFingerprint" value="SHA256:XqhGD0P8Q2cbGSNhwSZoGYfCfkfqXIRb3VGOC+MAWP4" />

  <!-- optional, default=none -->
  <option name="path" value="somedir/somesubdir" />
</sync>
